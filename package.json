{
  "name": "vellumscribe",
  "private": true,
  "description": "Offline-first multimodal note-taking studio with interactive checklists, drawing canvas, voice transcriptions, OCR document scans, PIN security, and cloud sync.",
  "license": "MIT",
  "version": "3.1.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:spa": "vite build",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:orphans": "node scripts/check-orphaned-files.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:orphans && npm run test",
    "setup:whisper": "bash scripts/setup-whisper-third-party.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@google/genai": "^2.31.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.2",
    "express": "^5.3.0",
    "lucide-react": "^1.48.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-window": "^2.4.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-window": "^2.0.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
