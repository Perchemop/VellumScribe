# Release signing configuration — copy to `android/keystore.properties`
# and fill in. NEVER commit the real file or the .jks it points to.
#
# A single, stable key is what allows a newly downloaded APK to replace the
# copy already installed on a phone. If this key changes, Android refuses the
# update with "App not installed" until the old app is uninstalled.
#
# Generate the keystore (store it somewhere safe and back it up):
#   keytool -genkeypair -v -keystore vellumscribe-release.jks \
#     -alias vellumscribe -keyalg RSA -keysize 2048 -validity 10000
#
# Then copy this file to android/keystore.properties and fill in:
#   storeFile     absolute path to the .jks (or relative to android/app)
#   storePassword keystore password
#   keyAlias      "vellumscribe"
#   keyPassword   key password

storeFile=/absolute/path/to/vellumscribe-release.jks
storePassword=CHANGE_ME
keyAlias=vellumscribe
keyPassword=CHANGE_ME
