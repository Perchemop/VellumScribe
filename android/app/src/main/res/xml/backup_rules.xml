<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive credentials, cryptographic keys, and master secrets -->
    <exclude domain="sharedpref" path="device_backup_credentials.xml" />
    <exclude domain="sharedpref" path="vellum_secure_prefs.xml" />
    <exclude domain="sharedpref" path="offline_ai_secrets.xml" />
    <exclude domain="root" path="keystore/" />

    <!-- Exclude large AI binary models to respect 25MB cloud backup limits -->
    <exclude domain="file" path="models/" />
    <exclude domain="file" path="speech_models/" />

    <!-- Exclude temporary processing audio chunks and caches -->
    <exclude domain="file" path="temp/" />
    <exclude domain="file" path="audio_chunks/" />
    <exclude domain="file" path="chunk_cache/" />

    <!-- Include user databases and note media storage -->
    <include domain="database" path="." />
    <include domain="file" path="storage/" />
    <include domain="file" path="notes/" />
</full-backup-content>
